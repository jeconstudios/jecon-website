---
// Shared body for platform, solution, and integration detail pages.
// Each feature carries an honest status so the site never claims more than ships:
//   available = in the product today, building = in active development, planned = on the roadmap.
import Icon from './Icon.astro';

const {
  eyebrow,
  icon = 'layers',
  title,
  lede,
  features = [],
  featuresTitle = 'What it does',
  stepsTitle,
  steps = [],
  stats = [],
  related = [],
  ctaTitle = 'See it on your own paperwork.',
  ctaCopy = 'Create an account and upload a real list of materials, PO, or packing list. Every AI proposal waits for your approval.',
} = Astro.props;

const statusLabel = { available: 'Available now', building: 'In development', planned: 'Planned' };
---
<section class="section-tight">
  <div class="wrap hero-split">
    <div>
      <span class="eyebrow"><Icon name={icon} size={14} /> {eyebrow}</span>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <div class="btn-row">
        <a href="/signup" class="btn">Create Account</a>
        <a href="/contact" class="btn secondary">Talk to Us</a>
      </div>
    </div>
    {stats.length > 0 ? (
      <div class="card">
        <ul class="tier-list" style="margin:0;">
          {stats.map((p) => (<li><Icon name="check" size={16} /><span>{p}</span></li>))}
        </ul>
      </div>
    ) : (
      <div class="icon-tile" style="width:100%; height:220px; border-radius:20px;" aria-hidden="true">
        <Icon name={icon} size={64} />
      </div>
    )}
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>{featuresTitle}</h2>
    <div class="grid grid-auto" style="margin-top:24px;">
      {features.map((f) => (
        <div class="card">
          <div class="icon-tile"><Icon name={f.icon} /></div>
          <span class={`status status-${f.status ?? 'available'}`}>{statusLabel[f.status ?? 'available']}</span>
          <h3>{f.title}</h3>
          <p style="margin:0; font-size:0.92rem;">{f.copy}</p>
        </div>
      ))}
    </div>
    <p class="status-note">Status labels reflect the product today. “Planned” items are on the roadmap, not shipped.</p>
  </div>
</section>

{steps.length > 0 && (
  <section class="section" style="background:#eef2ff;">
    <div class="wrap">
      <h2>{stepsTitle}</h2>
      <div class="grid grid-3" style="margin-top:24px;">
        {steps.map((s, i) => (
          <div class="card">
            <span class="stat-num" style="opacity:0.35;">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p style="margin:0; font-size:0.92rem;">{s.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<section class="section-tight">
  <div class="wrap">
    <div class="card cta-card">
      <h3>{ctaTitle}</h3>
      <p>{ctaCopy}</p>
      <div class="btn-row">
        <a href="/signup" class="btn">Create Account</a>
        <a href="/pricing" class="btn secondary">View Pricing</a>
      </div>
      {related.length > 0 && (
        <p class="related">Related: {related.map((r, i) => (<><a href={r.href}>{r.label}</a>{i < related.length - 1 ? ' · ' : ''}</>))}</p>
      )}
    </div>
  </div>
</section>

<style>
  .status { display: inline-block; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; padding: 4px 9px; border-radius: 6px; margin: 4px 0 2px; }
  .status-available { background: #dcfce7; color: #166534; }
  .status-building { background: #eef2ff; color: var(--royal); }
  .status-planned { background: #f1f5f9; color: var(--text-muted); }
  .status-note { font-size: 0.8rem; color: var(--text-muted); margin-top: 18px; }
  .cta-card h3 { margin-bottom: 8px; }
  .related { margin-top: 18px; font-size: 0.88rem; }
  .related a { font-weight: 700; color: var(--royal); }
</style>
