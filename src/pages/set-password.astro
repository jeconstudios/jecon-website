---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Set Your Password" description="Set your JECON Platform password.">
  <section class="section" style="max-width:480px; margin:0 auto;">
    <div class="wrap">
      <h1 style="margin-bottom:8px;">Set your password</h1>
      <p class="lede" style="margin-bottom:24px;">You've verified your email. Choose a password to finish setting up your account.</p>
      <div class="card">
        <form id="set-password-form">
          <label for="pw1">New Password</label>
          <input id="pw1" type="password" name="password" minlength="8" required>
          <label for="pw2">Confirm Password</label>
          <input id="pw2" type="password" name="password2" minlength="8" required>
          <div id="pw-message"></div>
          <button type="submit" class="btn block">Set Password & Continue</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabase.js';

  const form = document.getElementById('set-password-form');
  const msg = document.getElementById('pw-message');
  const show = (html, type) => { msg.innerHTML = `<div class="notice ${type}">${html}</div>`; };

  // The verification-link redirect lands here with an active session already
  // established by Supabase's client-side auth handling of the URL hash/params.
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const p1 = String(fd.get('password') || '');
    const p2 = String(fd.get('password2') || '');

    if (p1.length < 8) { show('Password must be at least 8 characters.', 'error'); return; }
    if (p1 !== p2) { show('Passwords do not match.', 'error'); return; }

    const { error } = await supabase.auth.updateUser({ password: p1 });
    if (error) {
      show(error.message || 'Could not set your password. Try the email link again.', 'error');
      return;
    }

    const { data: userData } = await supabase.auth.getUser();
    const tier = userData?.user?.user_metadata?.billing_tier;
    const truckCount = userData?.user?.user_metadata?.billing_truck_count ?? 3;
    const billingPeriod = userData?.user?.user_metadata?.billing_period === 'annual' ? 'annual' : 'monthly';
    const paidTiers = ['do_starter', 'do_professional', 'lms_starter', 'lms_professional'];
    const isPlatformUser = userData?.user?.user_metadata?.app === 'platform';

    const { data: sessionData } = await supabase.auth.getSession();
    const token = sessionData?.session?.access_token;

    // Every platform signup (free or paid) gets an organization + profile row
    // so the live dashboard and entitlement checks have something to attach
    // to. Safe to call repeatedly -- it's a no-op once an org already exists.
    if (isPlatformUser) {
      try { await supabase.rpc('platform_bootstrap_organization'); }
      catch (e) { console.error('Could not bootstrap organization', e); }
    }

    if (paidTiers.includes(tier)) {
      show('Password set. Taking you to secure checkout...', 'success');
      try {
        const resp = await fetch(
          `${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/billing-checkout`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
            body: JSON.stringify({
              action: 'create_checkout_session',
              tier,
              truck_count: truckCount,
              billing_period: billingPeriod,
              success_url: `${window.location.origin}/app/?checkout=success`,
              cancel_url: `${window.location.origin}/pricing?checkout=cancelled`,
            }),
          },
        );
        const result = await resp.json().catch(() => ({}));
        if (resp.ok && result.url) {
          window.location.href = result.url;
          return;
        }
        show(
          `Your account is set up, but checkout isn't available right now (${result.error || 'unknown error'}). You can finish upgrading later from the Pricing page.`,
          'error',
        );
        setTimeout(() => { window.location.href = '/app/'; }, 3500);
      } catch {
        show('Your account is set up, but we couldn\'t reach checkout. You can finish upgrading later from the Pricing page.', 'error');
        setTimeout(() => { window.location.href = '/app/'; }, 3500);
      }
      return;
    }

    show('Password set. Redirecting to your workspace...', 'success');
    setTimeout(() => { window.location.href = '/app/'; }, 1200);
  });
</script>
