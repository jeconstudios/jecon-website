---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const capabilities = [
  { icon: 'building', tag: 'Infrastructure', title: 'Enterprise Warehousing & Staging', copy: 'Access to multi-client and dedicated distribution facilities nationwide. Scalable high-bay storage, climate-controlled environments, and real-time inventory visibility.', badges: ['Nationwide Network', 'Multi-Shift Operations', 'Food-Grade / Ambient'] },
  { icon: 'truck', tag: 'Transportation', title: 'Dedicated Contract Freight & Drayage', copy: 'Managed line-haul, dedicated loops, and local port drayage. We orchestrate contracted tractor/trailer capacity to secure continuous freight lanes across the U.S.', badges: ['Dedicated Fleets', 'Shuttle & Loop Ops', 'Intermodal Staging'] },
  { icon: 'box', tag: 'Value-Added Services', title: 'Specialized Fulfillment & Kitting', copy: 'High-precision assembly, protective packaging, shrink-wrapping, RFID tagging, custom labeling, and multi-component kitting to exact agency specifications.', badges: ['Mission Kitting', 'Pick, Pack & Ship', 'Reverse Logistics'] },
  { icon: 'gear', tag: 'Supply Chain Systems', title: 'Technology & Yard Management', copy: 'Integration of proven logistics systems for WMS, yard management, and ERP. End-to-end telemetry for gate activity, dwell times, and inventory custody.', badges: ['Real-Time WMS / TMS', 'KPI Analytics', 'Cybersecurity'] },
  { icon: 'clipboard', tag: 'Quality & Audit', title: 'Compliance & Financial Oversight', copy: 'Disciplined budget administration, audit readiness, cost-variance reporting, and strict quality control standards ensuring adherence to government mandates.', badges: ['DCAA Audit Readiness', 'Zero-Defect QA', 'NIST SP 800-171'] },
  { icon: 'shield', tag: 'Prime Oversight', title: 'Federal Program Management', copy: 'Complete programmatic governance, milestone alignment, and technical compliance. We direct cross-functional teams and monitor multi-tier supply arrangements to ensure mission continuity.', badges: ['P&L Accountability', 'SOW Compliance', 'FAR / DFARS'] },
];
---
<BaseLayout title="Services" description="JECON LLC's warehousing, transportation, fulfillment, supply chain systems, and federal program management services.">

  <section class="section-tight">
    <div class="wrap hero-split">
      <div>
        <span class="eyebrow"><Icon name="compass" size={14} /> Program Capabilities</span>
        <h1>Integrated execution pillars.</h1>
        <p class="lede">JECON combines nationwide logistics infrastructure with prime-level program oversight — for commercial customers and for government contracts. It is the operating discipline behind the JECON Platform.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-auto">
        {capabilities.map((c) => (
          <div class="card">
            <div class="icon-tile"><Icon name={c.icon} /></div>
            <span class="eyebrow">{c.tag}</span>
            <h3>{c.title}</h3>
            <p style="font-size:0.92rem;">{c.copy}</p>
            <div class="badge-list">
              {c.badges.map((b) => <span class="badge">{b}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:#eef2ff;">
    <div class="wrap grid grid-2">
      <div class="card">
        <h2>Our program management model</h2>
        <p>JECON LLC operates as a mission-oriented integrator, delivering the structural rigor, compliance safeguards, and logistics leadership required to execute complex procurement and operational mandates.</p>
        <p>Through established vendor partnerships with nationwide warehousing networks, dedicated transport carriers, and automated fulfillment hubs, we orchestrate execution power while providing a single, accountable point of contact.</p>
        <h3 style="margin-top:24px;">The JECON 3-phase execution framework</h3>
        <div class="grid grid-3" style="margin-top:14px;">
          <div><span class="stat-num" style="opacity:0.35; display:block;">01</span><strong>Architect</strong><p style="font-size:0.85rem; margin:4px 0 0;">Requirements review, freight lane modeling, facility layout, risk mitigation.</p></div>
          <div><span class="stat-num" style="opacity:0.35; display:block;">02</span><strong>Integrate</strong><p style="font-size:0.85rem; margin:4px 0 0;">Dedicated management, multi-shift workforce scheduling, secure digital workflows.</p></div>
          <div><span class="stat-num" style="opacity:0.35; display:block;">03</span><strong>Oversee</strong><p style="font-size:0.85rem; margin:4px 0 0;">KPI reporting, audit-ready compliance, continuous optimization.</p></div>
        </div>
      </div>
      <div class="card dark">
        <h3>Corporate credentials</h3>
        <table class="data-table">
          <tr><td style="color:#94a3b8;">CAGE Code</td><td style="color:white; font-weight:700;">7VY13</td></tr>
          <tr><td style="color:#94a3b8;">UEI</td><td style="color:white; font-weight:700;">CGEEA5U4TPA9</td></tr>
          <tr><td style="color:#94a3b8;">Headquarters</td><td style="color:white;">Sierra Vista, AZ</td></tr>
          <tr><td style="color:#94a3b8;">Incorporated</td><td style="color:white;">2017</td></tr>
        </table>
        <h3 style="margin-top:24px;">Core NAICS codes</h3>
        <ul style="color:#cbd5e1; font-size:0.85rem;">
          <li><strong>541611</strong> — Admin & General Management</li>
          <li><strong>541614</strong> — Process & Logistics Consulting</li>
          <li><strong>493110</strong> — General Warehousing & Storage</li>
          <li><strong>484110</strong> — General Freight Trucking, Local</li>
          <li><strong>484121</strong> — General Freight Trucking, Long-Distance</li>
          <li><strong>561110</strong> — Office Administrative Services</li>
          <li><strong>541219</strong> — Other Accounting Services</li>
          <li><strong>561499</strong> — All Other Business Support Services</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="card" style="text-align:center;">
        <h2>Also building the JECON Platform</h2>
        <p style="max-width:560px; margin:0 auto 20px;">The same execution discipline described above, built into AI-assisted logistics management and fleet operations software.</p>
        <a href="/platform" class="btn">Explore the Platform</a>
      </div>
    </div>
  </section>

</BaseLayout>
