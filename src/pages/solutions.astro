---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const segments = [
  {
    id: 'commercial',
    icon: 'building',
    title: 'Commercial Businesses',
    tag: 'Supply Chain Management',
    copy: 'Procurement, inventory, and reorder discipline without buying an ERP.',
    points: [
      'Upload a LOM (list of materials) in whatever format you already use — Excel, CSV, PDF, even a photo',
      'Procurement tracking from quote to stocked, with stale-update reminders',
      'Inventory hierarchy from site to bin, with barcode/QR labels',
      'AI-suggested reorder points that always wait for your approval',
    ],
  },
  {
    id: 'carrier',
    icon: 'truck',
    title: 'Carriers & Fleets',
    tag: 'DispatchOps AI',
    copy: 'Less time on paperwork between loads, more time moving freight.',
    points: [
      'Billing and proof-of-delivery extraction from rate confirmations',
      'Driver qualification file tracking before expirations become violations',
      'Broker fraud and identity vetting before a load is booked',
      'Settlement drafts prepared for owner-operator approval',
    ],
  },
  {
    id: 'individual',
    icon: 'users',
    title: 'Individuals & Owner-Operators',
    tag: 'Starter-friendly',
    copy: "A simple way to track materials, orders, and paperwork without a back office.",
    points: [
      'Free tier to get started — no card required',
      'Civilian hand-receipt templates for personal or small-crew property',
      "Freight visibility for anything you're waiting on",
      'Everything a small team needs, none of the overhead',
    ],
  },
  {
    id: 'government',
    icon: 'shield',
    title: 'Government Contractors',
    tag: 'DPAS priority ratings, hand-receipt templates',
    copy: "The same supply chain tools, with the controls a contracting officer expects.",
    points: [
      'Locked LOM baselines with recorded approvals for audit readiness',
      'DPAS priority ratings (DO / DX) tracked on each rated order, with rated long-lead items flagged',
      'DA 2062, DD 1149, DD 1348-1A, and DD 250 hand-receipt templates',
      'Variance reports sized in dollars and percent for contracting officers',
    ],
  },
];
---
<BaseLayout title="Solutions" description="JECON solutions by operation (3PL, wholesale distribution, eCommerce fulfillment) and by audience: commercial businesses, carriers and fleets, individuals, and government contractors.">

  <section class="section-tight">
    <div class="wrap">
      <span class="eyebrow"><Icon name="compass" size={14} /> Solutions</span>
      <h1>One supply chain platform, tuned to how your operation runs.</h1>
      <p class="lede">Every segment gets the same audit trail and human-approval model underneath — the difference is which pieces come front and center.</p>
    </div>
  </section>

  <section class="section" style="background:#eef2ff; padding-top:40px;">
    <div class="wrap">
      <span class="eyebrow">By operation</span>
      <div class="grid grid-auto" style="margin-top:16px;">
        {[
          { href: '/solutions/3pl', icon: 'layers', title: '3PL Providers', copy: 'Multi-client inventory, receiving, and shipping.' },
          { href: '/solutions/wholesale-distributors', icon: 'building', title: 'Wholesale Distributors', copy: 'Reorder points, vendor POs, and ship-to-account.' },
          { href: '/solutions/ecommerce-fulfillment', icon: 'bolt', title: 'eCommerce Fulfillment', copy: 'Scan-confirmed pick-and-pack at volume.' },
        ].map((f) => (
          <a href={f.href} class="card" style="display:block;">
            <div class="icon-tile"><Icon name={f.icon} /></div>
            <h3>{f.title}</h3>
            <p style="margin:0; font-size:0.92rem;">{f.copy}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {segments.map((s, i) => (
    <section class="section" id={s.id} style={i % 2 === 1 ? 'background:#eef2ff;' : ''}>
      <div class="wrap">
        <div class="hero-split">
          <div class={i % 2 === 1 ? 'order-2' : ''}>
            <div class="icon-tile"><Icon name={s.icon} /></div>
            <span class="eyebrow">{s.tag}</span>
            <h2>{s.title}</h2>
            <p class="lede">{s.copy}</p>
            <div class="btn-row">
              <a href="/signup" class="btn">Create Account</a>
              <a href="/contact" class="btn secondary">Talk to Us</a>
            </div>
          </div>
          <div class="card">
            <ul class="tier-list" style="margin:0;">
              {s.points.map((p) => (
                <li><Icon name="check" size={16} /><span>{p}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  ))}

</BaseLayout>

<style>
  .order-2 { order: 2; }
  @media (max-width: 980px) { .order-2 { order: 0; } }
</style>
