---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const tiers = [
  {
    name: 'Free', price: '$0', period: '',
    features: ['25 AI pages / mo', '1 user', '1 active project', 'No DoD forms', 'No SSO / audit export'],
    cta: 'Create Account', href: '/signup', featured: false,
  },
  {
    name: 'Starter', price: '$29', period: '/mo',
    features: ['300 AI pages / mo', '2 users', '3 active projects', 'No DoD forms', 'No SSO / audit export'],
    cta: 'Create Account', href: '/signup', featured: false,
  },
  {
    name: 'Professional', price: '$129', period: '/mo',
    features: ['2,000 AI pages / mo', '5 users (+$19/extra)', 'Unlimited active projects', 'DoD forms included', 'No SSO / audit export'],
    cta: 'Create Account', href: '/signup', featured: true,
  },
  {
    name: 'Enterprise / Gov', price: 'From $499', period: '/mo (annual)',
    features: ['10,000+ AI pages / mo', '10+ users', 'Unlimited active projects', 'DoD forms included', 'SSO, audit export & PO/invoice billing'],
    cta: 'Contact Us', href: '/contact', featured: false,
  },
];
---
<BaseLayout title="Pricing" description="JECON Platform pricing: Free, Starter, Professional, and Enterprise/Gov tiers.">

  <section class="section-tight" style="background:var(--navy);">
    <div class="wrap" style="text-align:center;">
      <span class="eyebrow on-dark"><Icon name="chart" size={14} /> Pricing</span>
      <h1 style="color:white;">Plans that scale with you.</h1>
      <p class="lede" style="color:#cbd5e1; margin: 0 auto;">A flat monthly price plus metered AI document pages — everything else on your tier is unlimited. Self-serve card checkout for Free, Starter, and Professional.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="tier-grid">
        {tiers.map((t) => (
          <div class={`tier-card ${t.featured ? 'featured' : ''}`}>
            {t.featured && <span class="badge" style="align-self:flex-start; margin-bottom:8px;">Most popular</span>}
            <span class="eyebrow" style="align-self:flex-start;">{t.name}</span>
            <div class="tier-price">{t.price}<small>{t.period}</small></div>
            <ul class="tier-list">
              {t.features.map((f) => (
                <li><Icon name="check" size={16} /><span>{f}</span></li>
              ))}
            </ul>
            <a href={t.href} class={`btn block ${t.featured ? '' : 'secondary'}`}>{t.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="card">
        <h3>Overage & add-ons</h3>
        <div class="grid grid-2">
          <ul style="margin:0;">
            <li>Overage: $25 top-up per 500 extra AI pages, or metered at $0.06/page</li>
            <li>Annual billing: 2 months free on any paid tier</li>
          </ul>
          <ul style="margin:0;">
            <li>Fleet Operations add-on (early access): from ~$79/mo base + per-truck charge</li>
            <li>Need PO or invoice billing? Choose it at signup, or contact us and we'll set it up</li>
          </ul>
        </div>
        <div class="notice" style="margin-top:16px;">
          Prices above are current planning figures and may be adjusted before they're finalized in checkout. Card checkout is handled by Stripe; PO/invoice billing for Enterprise/Gov is set up with our team directly.
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
