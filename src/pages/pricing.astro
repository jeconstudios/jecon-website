---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const dispatchOpsTiers = [
  {
    name: 'Starter', price: '$99', period: '/mo', annualPrice: '$990', annualPeriod: '/yr', note: 'Up to 3 trucks',
    features: [
      'Carrier & driver portal',
      'Load board & dispatch pipeline',
      'DQF + Clearinghouse compliance tracking',
      'Rate confirmation e-signature',
      'Unlimited AI document processing',
    ],
    cta: 'Create Account', href: '/signup?system=dispatchops&tier=starter', featured: false,
  },
  {
    name: 'Professional', price: '$149', period: '/mo', annualPrice: '$1,490', annualPeriod: '/yr', note: '3 trucks included, then +$12/truck (+$120/truck/yr annual)',
    features: [
      'Everything in Starter, plus:',
      'Broker fraud & identity vetting (hard gate)',
      'Telematics auto check-calls (Samsara/Motive)',
      'Truck-legal routing + live fuel price context',
      'AI-drafted carrier outreach & follow-up scheduling',
      'Invoicing & settlements',
      'Unlimited AI document processing',
    ],
    cta: 'Create Account', href: '/signup?system=dispatchops&tier=professional', featured: true, truckInput: true,
  },
  {
    name: 'Enterprise', price: 'From $599', period: '/mo', note: '~30 trucks, custom beyond',
    features: [
      'Everything in Professional, plus:',
      'Multi-dispatcher / multi-location support',
      'SSO & audit export',
      'Dedicated onboarding',
      'Custom load-board integrations (Highway, DAT)',
      'Unlimited AI document processing, PO/invoice billing',
    ],
    cta: 'Contact Us', href: '/contact', featured: false,
  },
];

const lmsTiers = [
  {
    name: 'Starter', price: '$29', period: '/mo', annualPrice: '$290', annualPeriod: '/yr', note: 'No per-user or per-project caps',
    features: [
      'LOM ingestion (baseline)',
      'Inventory & warehouse locations',
      'Reorder point alerts',
      'Unlimited AI document processing',
    ],
    cta: 'Create Account', href: '/signup?system=lms&tier=starter', featured: false,
  },
  {
    name: 'Professional', price: '$299', period: '/mo', annualPrice: '$2,990', annualPeriod: '/yr', note: 'Unlimited active projects',
    features: [
      'Everything in Starter, plus:',
      'LOM baseline control & variance detection',
      'Long-lead item analysis',
      'Procurement tracking',
      'Hand receipts & property transfers',
      'DPAS priority-rating tracking on procurement orders',
      'Freight visibility',
      'Unlimited AI document processing',
    ],
    cta: 'Create Account', href: '/signup?system=lms&tier=professional', featured: true,
  },
  {
    name: 'Enterprise', price: '$699', period: '/mo', note: 'Multi-warehouse',
    features: [
      'Everything in Professional, plus:',
      'Multi-warehouse support',
      'SSO & audit export',
      'Dedicated account management',
      'Custom integrations',
      'Unlimited AI document processing, PO/invoice billing',
    ],
    cta: 'Contact Us', href: '/contact', featured: false,
  },
];
---
<BaseLayout title="Pricing" description="JECON Platform pricing for DispatchOps AI and Logistics Management (LMS) — Starter, Professional, and Enterprise tiers.">

  <section class="section-tight" style="background:var(--navy);">
    <div class="wrap" style="text-align:center;">
      <span class="eyebrow on-dark"><Icon name="chart" size={14} /> Pricing</span>
      <h1 style="color:white;">Plans that scale with you.</h1>
      <p class="lede" style="color:#cbd5e1; margin: 0 auto;">Each system is priced and billed separately, so you only pay for what you use. Self-serve card checkout for Starter and Professional on both systems. No AI usage caps on any paid tier.</p>
      <div style="display:inline-flex; align-items:center; gap:10px; margin-top:20px; background:rgba(255,255,255,0.08); border-radius:999px; padding:4px;">
        <button type="button" id="billing-toggle-monthly" class="billing-toggle-btn active" style="padding:8px 18px; border-radius:999px; border:none; font-size:0.85rem; font-weight:600; cursor:pointer;">Monthly</button>
        <button type="button" id="billing-toggle-annual" class="billing-toggle-btn" style="padding:8px 18px; border-radius:999px; border:none; font-size:0.85rem; font-weight:600; cursor:pointer;">Annual <span style="opacity:0.75; font-weight:500;">— 2 months free</span></button>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap" style="text-align:center;">
      <div class="card" style="max-width:520px; margin:0 auto;">
        <span class="eyebrow" style="align-self:center;">Free</span>
        <div class="tier-price">$0<small>/mo</small></div>
        <p style="font-size:0.9rem; color:var(--text-muted); margin:8px 0 16px;">Unlimited AI document processing. 1 user, 1 active project. Pick DispatchOps AI or LMS when you create your account — upgrade either one independently, whenever you're ready.</p>
        <a href="/signup" class="btn block secondary">Create Free Account</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow"><Icon name="chart" size={14} /> DispatchOps AI</span>
      <h2 style="margin-bottom:20px;">Fleet dispatch & compliance, without the per-truck markup.</h2>
      <div class="tier-grid" style="grid-template-columns: repeat(3, 1fr);">
        {dispatchOpsTiers.map((t) => (
          <div class={`tier-card ${t.featured ? 'featured' : ''}`} data-tier-card={t.truckInput ? 'do-professional' : undefined}>
            {t.featured && <span class="badge" style="align-self:flex-start; margin-bottom:8px;">Most popular</span>}
            <span class="eyebrow" style="align-self:flex-start;">{t.name}</span>
            <div class="tier-price" data-monthly-price={t.price} data-monthly-period={t.period} data-annual-price={t.annualPrice ?? t.price} data-annual-period={t.annualPeriod ?? t.period}>{t.price}<small>{t.period}</small></div>
            <p style="font-size:0.8rem; color:var(--text-muted); margin:-2px 0 10px;">{t.note}</p>
            <ul class="tier-list">
              {t.features.map((f) => (
                <li><Icon name="check" size={16} /><span>{f}</span></li>
              ))}
            </ul>
            {t.truckInput && (
              <div style="margin-bottom:12px;">
                <label for="do-truck-count" style="font-size:0.8rem; font-weight:600;">Number of trucks</label>
                <input id="do-truck-count" type="number" min="1" value="3" style="width:100%; margin-top:4px;">
              </div>
            )}
            <a href={t.href} class={`btn block ${t.featured ? '' : 'secondary'} ${t.annualPrice ? 'pricing-cta' : ''}`} data-tier-cta={t.truckInput ? 'do-professional' : undefined} data-base-href={t.href}>{t.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow"><Icon name="chart" size={14} /> Logistics Management (LMS)</span>
      <h2 style="margin-bottom:20px;">LOM, procurement, and warehouse control in one system.</h2>
      <div class="tier-grid" style="grid-template-columns: repeat(3, 1fr);">
        {lmsTiers.map((t) => (
          <div class={`tier-card ${t.featured ? 'featured' : ''}`}>
            {t.featured && <span class="badge" style="align-self:flex-start; margin-bottom:8px;">Most popular</span>}
            <span class="eyebrow" style="align-self:flex-start;">{t.name}</span>
            <div class="tier-price" data-monthly-price={t.price} data-monthly-period={t.period} data-annual-price={t.annualPrice ?? t.price} data-annual-period={t.annualPeriod ?? t.period}>{t.price}<small>{t.period}</small></div>
            <p style="font-size:0.8rem; color:var(--text-muted); margin:-2px 0 10px;">{t.note}</p>
            <ul class="tier-list">
              {t.features.map((f) => (
                <li><Icon name="check" size={16} /><span>{f}</span></li>
              ))}
            </ul>
            <a href={t.href} class={`btn block ${t.featured ? '' : 'secondary'} ${t.annualPrice ? 'pricing-cta' : ''}`} data-base-href={t.href}>{t.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="card">
        <h3>Overage & add-ons</h3>
        <div class="grid grid-2">
          <ul style="margin:0;">
            <li>No AI usage caps — unlimited document processing on every paid tier, no overage charges</li>
            <li>Annual billing: 2 months free on any paid tier (toggle above)</li>
          </ul>
          <ul style="margin:0;">
            <li>Run both DispatchOps AI and LMS? Each is billed on its own plan — mix and match tiers freely</li>
            <li>Need PO or invoice billing? Choose Enterprise and contact us, or ask us to set it up on Professional</li>
          </ul>
        </div>
        <div class="notice" style="margin-top:16px;">
          Card checkout is handled by Stripe. Enterprise tiers on both systems are set up with our team directly (PO/invoice billing available).
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // Keeps the DispatchOps Professional "Create Account" link's truck count
  // query param in sync with the number input, so signup/checkout bills the
  // right number of additional trucks from the start.
  const input = document.getElementById('do-truck-count') as HTMLInputElement | null;
  const truckCta = document.querySelector('[data-tier-cta="do-professional"]') as HTMLAnchorElement | null;

  // Monthly/annual toggle: swaps displayed prices and appends ?billing=annual
  // to every self-serve CTA link, carried through signup -> set-password ->
  // Stripe Checkout so the right Price ID (monthly or annual) gets billed.
  const monthlyBtn = document.getElementById('billing-toggle-monthly');
  const annualBtn = document.getElementById('billing-toggle-annual');
  let period: 'monthly' | 'annual' = 'monthly';

  function applyPrices() {
    document.querySelectorAll('.tier-price[data-monthly-price]').forEach((el) => {
      const price = period === 'annual' ? el.getAttribute('data-annual-price') : el.getAttribute('data-monthly-price');
      const unit = period === 'annual' ? el.getAttribute('data-annual-period') : el.getAttribute('data-monthly-period');
      const small = el.querySelector('small');
      if (el.firstChild && el.firstChild.nodeType === Node.TEXT_NODE) el.firstChild.textContent = price;
      if (small) small.textContent = unit;
    });
  }

  function syncCtas() {
    document.querySelectorAll('a.pricing-cta[data-base-href]').forEach((a) => {
      const anchor = a as HTMLAnchorElement;
      const base = anchor.getAttribute('data-base-href') || anchor.getAttribute('href') || '';
      const url = new URL(base, window.location.origin);
      url.searchParams.set('billing', period);
      if (anchor === truckCta && input) {
        const trucks = Math.max(1, Math.trunc(Number(input.value) || 1));
        url.searchParams.set('trucks', String(trucks));
      }
      anchor.setAttribute('href', `${url.pathname}${url.search}`);
    });
  }

  function setPeriod(p: 'monthly' | 'annual') {
    period = p;
    monthlyBtn?.classList.toggle('active', p === 'monthly');
    annualBtn?.classList.toggle('active', p === 'annual');
    if (monthlyBtn) monthlyBtn.style.background = p === 'monthly' ? 'white' : 'transparent';
    if (monthlyBtn) monthlyBtn.style.color = p === 'monthly' ? '#0f172a' : 'white';
    if (annualBtn) annualBtn.style.background = p === 'annual' ? 'white' : 'transparent';
    if (annualBtn) annualBtn.style.color = p === 'annual' ? '#0f172a' : 'white';
    applyPrices();
    syncCtas();
  }

  monthlyBtn?.addEventListener('click', () => setPeriod('monthly'));
  annualBtn?.addEventListener('click', () => setPeriod('annual'));
  input?.addEventListener('input', syncCtas);
  setPeriod('monthly');
</script>
