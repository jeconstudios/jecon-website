---
import BaseLayout from '../layouts/BaseLayout.astro';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const validSystems = ['dispatchops', 'lms'];
const validTiers = ['starter', 'professional'];
const rawSystem = Astro.url.searchParams.get('system') || '';
const rawTier = Astro.url.searchParams.get('tier') || '';
const hasPlan = validSystems.includes(rawSystem) && validTiers.includes(rawTier);

// billing_tier stored on the user is "do_starter" / "do_professional" /
// "lms_starter" / "lms_professional" — matches billing-checkout's TIER_CONFIG
// keys exactly. "free" means no checkout step after signup.
const requestedTier = hasPlan ? `${rawSystem === 'dispatchops' ? 'do' : 'lms'}_${rawTier}` : 'free';
const requestedTrucks = Math.max(1, Math.trunc(Number(Astro.url.searchParams.get('trucks')) || 3));
const requestedBilling = Astro.url.searchParams.get('billing') === 'annual' ? 'annual' : 'monthly';
const requestedModule = rawSystem === 'dispatchops' ? 'dispatch_ops' : rawSystem === 'lms' ? 'logistics_management' : null;

const tierCopy: Record<string, string> = {
  do_starter: 'DispatchOps AI — Starter ($99/mo)',
  do_professional: `DispatchOps AI — Professional ($149/mo, ${requestedTrucks} trucks)`,
  lms_starter: 'LMS — Starter ($29/mo)',
  lms_professional: 'LMS — Professional ($299/mo)',
};
---
<BaseLayout title="Create Account" description="Create your JECON Platform account — self-serve, no approval gate.">

  <section class="section" style="max-width:640px; margin:0 auto;">
    <div class="wrap">
      <span class="eyebrow">JECON Platform</span>
      <h1 style="margin-bottom:8px;">Create your account</h1>
      <p class="lede" style="margin-bottom:28px;">Four fields. No approval wait. You'll get an email to verify your address and set your password.</p>

      {tierCopy[requestedTier] && (
        <div class="notice" style="margin-bottom:20px;">
          Selected plan: <strong>{tierCopy[requestedTier]}</strong>. After you verify your email and set a password, you'll be sent to secure checkout to finish setting it up.
        </div>
      )}

      <div class="card">
        <form id="signup-form" novalidate>
          <input type="hidden" name="tier" value={requestedTier}>
          <input type="hidden" name="truck_count" value={requestedTrucks}>
          <input type="hidden" name="billing_period" value={requestedBilling}>
          <input type="hidden" name="module" value={requestedModule ?? ''}>
          <input type="text" name="_honey" class="hp-field" tabindex="-1" autocomplete="off">

          <label for="su-name">Full Name</label>
          <input id="su-name" type="text" name="name" placeholder="First and last name" required>

          <label for="su-email">Email Address</label>
          <input id="su-email" type="email" name="email" placeholder="you@company.com" required>

          <label for="su-org">Organization</label>
          <input id="su-org" type="text" name="organization" placeholder="Company or business name" required>

          <label for="su-type">Account Type</label>
          <select id="su-type" name="account_type" required>
            <option value="">Select one...</option>
            <option value="government">Government contractor</option>
            <option value="carrier">Carrier / fleet</option>
            <option value="business">Commercial business</option>
            <option value="individual">Individual / owner-operator</option>
          </select>

          {turnstileSiteKey && (
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey} style="margin-bottom:16px;"></div>
          )}

          <div class="check-row">
            <input type="checkbox" id="su-agree" name="agreed" required>
            <label for="su-agree" style="font-weight:400; margin:0;">
              I agree to the <a href="/terms">Terms of Use</a> and <a href="/privacy">Privacy Policy</a>, and I will not upload CUI, export-controlled, or classified data.
            </label>
          </div>

          <div id="signup-message"></div>
          <button type="submit" class="btn block">Create My Account</button>
        </form>

        <p style="text-align:center; font-size:0.85rem; margin-top:16px;">Already have an account? <a href="/signin">Sign in</a></p>
      </div>
    </div>
  </section>

</BaseLayout>

{turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import { supabase } from '../lib/supabase.js';

  const form = document.getElementById('signup-form');
  const msg = document.getElementById('signup-message');
  const show = (html, type) => { msg.innerHTML = `<div class="notice ${type}">${html}</div>`; };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]');
    const fd = new FormData(form);

    if (fd.get('_honey')) return; // spam trap

    const name = String(fd.get('name') || '').trim();
    const email = String(fd.get('email') || '').trim();
    const organization = String(fd.get('organization') || '').trim();
    const accountType = String(fd.get('account_type') || '');
    const tier = String(fd.get('tier') || 'free');
    const truckCount = Math.max(1, Math.trunc(Number(fd.get('truck_count')) || 3));
    const billingPeriod = String(fd.get('billing_period') || 'monthly');
    const selectedModule = String(fd.get('module') || '');

    if (!name || !organization || !accountType) {
      show('Please complete name, organization, and account type.', 'error');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      show('Please enter a valid email address.', 'error');
      return;
    }
    if (!fd.get('agreed')) {
      show('Please agree to the Terms of Use and Privacy Policy to continue.', 'error');
      return;
    }

    const original = btn.textContent;
    btn.textContent = 'Creating account...';
    btn.disabled = true;

    // No password field on this form by design (4 fields only). We sign up with a
    // throwaway random password; the email-verification link logs the user in and
    // sends them to /set-password to choose their own.
    const throwawayPassword = crypto.randomUUID() + crypto.randomUUID();
    const captchaToken = document.querySelector('input[name="cf-turnstile-response"]')?.value;

    const { error } = await supabase.auth.signUp({
      email,
      password: throwawayPassword,
      options: {
        emailRedirectTo: `${window.location.origin}/set-password`,
        captchaToken,
        data: {
          app: 'platform',
          full_name: name,
          organization,
          account_type: accountType,
          services_of_interest: selectedModule ? [selectedModule] : (accountType === 'carrier' ? ['dispatch_ops'] : ['logistics_management']),
          billing_tier: tier,
          billing_truck_count: truckCount,
          billing_period: billingPeriod,
        },
      },
    });

    if (error) {
      show(error.message || 'Something went wrong creating your account. Please try again.', 'error');
      btn.textContent = original;
      btn.disabled = false;
      return;
    }

    show(`<strong>Almost there.</strong> Check ${email.replace(/</g, '&lt;')} for a verification link — it will bring you back here to set your password.`, 'success');
    form.reset();
    btn.textContent = original;
    btn.disabled = false;
  });
</script>
