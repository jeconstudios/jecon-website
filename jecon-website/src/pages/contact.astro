---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Contact" description="Contact JECON LLC for federal program management, logistics teaming, or a JECON Platform demo.">

  <section class="section-tight">
    <div class="wrap">
      <span class="eyebrow"><Icon name="doc" size={14} /> Inquiries & Teaming</span>
      <h1>Contact JECON LLC</h1>
      <p class="lede">Reach our leadership to discuss solicitations, teaming arrangements, program management support, or a JECON Platform demo.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid" style="grid-template-columns: 1fr 2fr;">
      <div class="card dark">
        <h3>Corporate office</h3>
        <p style="color:#cbd5e1; font-size:0.9rem;">JECON LLC<br>2700 E. Fry Boulevard, Suite B1-D<br>Sierra Vista, AZ 85635</p>
        <p style="color:#cbd5e1; font-size:0.9rem;">
          <strong>Direct:</strong> (520) 355-2306<br>
          <strong>Inquiries:</strong> info@jeconllc.com<br>
          <strong>Executive:</strong> dconnolly@jeconllc.com
        </p>
        <div style="background:rgba(255,255,255,0.1); padding:18px; border-radius:10px; margin-top:16px;">
          <h4 style="color:white; margin-bottom:8px;">Executive consultation</h4>
          <p style="color:#cbd5e1; font-size:0.85rem; margin-bottom:14px;">Schedule an introductory briefing with our leadership team.</p>
          <a href="https://calendly.com/connollydj/30min" target="_blank" rel="noopener" class="btn on-dark secondary block">Schedule Consultation</a>
        </div>
      </div>

      <div class="card">
        <h3>Send a direct request</h3>
        <form id="contact-form">
          <div class="form-row">
            <div><label for="c-name">Full Name</label><input id="c-name" type="text" name="name" placeholder="Name and title" required></div>
            <div><label for="c-email">Email Address</label><input id="c-email" type="email" name="email" placeholder="you@agency.gov" required></div>
          </div>
          <label for="c-service">Service Area</label>
          <select id="c-service" name="service">
            <option>Federal Program Management</option>
            <option>Integrated Logistics & Warehousing</option>
            <option>Dedicated Transportation & Freight Oversight</option>
            <option>Kitting, Assembly & Value-Added Services</option>
            <option>Financial & Operational Compliance</option>
            <option>Teaming & Subcontracting Opportunity</option>
            <option>Platform Access / Demo</option>
          </select>
          <label for="c-message">Message / SOW Details</label>
          <textarea id="c-message" name="message" rows="5" placeholder="Outline mission scope, timeline, and requirements..." required></textarea>
          <div id="contact-message"></div>
          <button type="submit" class="btn block">Submit Information</button>
        </form>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="card">
        <h3>Frequently asked</h3>
        <div class="grid grid-3">
          <div><strong>What contract vehicles does JECON support?</strong><p style="font-size:0.9rem;">We support prime federal contracts, GSA schedules, and direct agency solicitations. Contact our leadership team to evaluate specific set-asides.</p></div>
          <div><strong>How does JECON manage large-scale logistics without bureaucratic bloat?</strong><p style="font-size:0.9rem;">We serve as lead program manager, deploying pre-screened Tier-1 nationwide subcontractor networks while maintaining hands-on quality, fiscal, and regulatory control.</p></div>
          <div><strong>What is JECON's geographic service capacity?</strong><p style="font-size:0.9rem;">Headquartered in Sierra Vista, Arizona, JECON supports operational footprints across 30+ U.S. metropolitan hubs.</p></div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', function (e) {
    e.preventDefault();
    const btn = form.querySelector('button');
    const msg = document.getElementById('contact-message');
    const original = btn.textContent;
    btn.textContent = 'Sending...';
    btn.disabled = true;

    fetch('https://formsubmit.co/ajax/info@jeconllc.com', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(Object.fromEntries(new FormData(form))),
    })
      .then((r) => r.json())
      .then(() => {
        msg.innerHTML = '<div class="notice success">Message received. We\'ll be in touch shortly.</div>';
        form.reset();
      })
      .catch(() => {
        msg.innerHTML = '<div class="notice error">Something went wrong. Please try again, or email info@jeconllc.com.</div>';
      })
      .finally(() => {
        btn.textContent = original;
        btn.disabled = false;
      });
  });
</script>
